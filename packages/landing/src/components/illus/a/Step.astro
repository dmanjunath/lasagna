---
// One small picture per How it works step: accounts joining into one, a list
// with estimate tags, a question answered with the math, one choice picked.
export interface Props { kind: "connect" | "actions" | "chat" | "decide"; }
const { kind } = Astro.props;
---

<svg class="illus il-mini" data-illus={`a-step-${kind}`} viewBox="0 0 160 96" aria-hidden="true">
  {kind === "connect" && (
    <g>
      <rect x="6" y="10" width="44" height="18" rx="6" style="fill:var(--ui-tint-income-accent)" data-fx="left" />
      <rect x="6" y="39" width="44" height="18" rx="6" style="fill:var(--ui-tint-spend-accent)" data-fx="left" />
      <rect x="6" y="68" width="44" height="18" rx="6" style="fill:var(--ui-tint-wealth-accent)" data-fx="left" />
      <path d="M50 19 C74 19 70 48 96 48 M50 48 H96 M50 77 C74 77 70 48 96 48" class="il-flow-mini" />
      <rect x="96" y="24" width="58" height="48" rx="12" class="il-card" data-fx="pop" data-step="1" />
      <path d="M106 60 l10 -8 l8 4 l18 -14" class="il-line-mini" data-fx="pop" data-step="1" />
    </g>
  )}
  {kind === "actions" && (
    <g>
      {[0, 1, 2].map((i) => (
        <g data-fx="left">
          <rect x="10" y={8 + i * 28} width="140" height="22" rx="8" class="il-chip" />
          <rect x="18" y={15 + i * 28} width={54 - i * 10} height="8" rx="4" class="il-bar" />
          <rect x="104" y={13 + i * 28} width="38" height="12" rx="6" style="fill:var(--ui-tint-goal-accent)" />
        </g>
      ))}
    </g>
  )}
  {kind === "chat" && (
    <g>
      <g data-fx="up">
        <rect x="8" y="8" width="60" height="30" rx="12" style="fill:var(--ui-tint-goal)" />
        <text x="38" y="29" text-anchor="middle" class="il-q">?</text>
      </g>
      <g data-fx="up" data-step="1">
        <rect x="18" y="50" width="136" height="36" rx="12" style="fill:var(--ui-brand-soft)" />
        <text x="86" y="73" text-anchor="middle" class="il-math">$2,879 × 24.99%</text>
      </g>
    </g>
  )}
  {kind === "decide" && (
    <g>
      <rect x="12" y="20" width="40" height="56" rx="12" class="il-chip" />
      <rect x="60" y="12" width="40" height="72" rx="12" class="il-choice-on" data-fx="grow" />
      <rect x="108" y="30" width="40" height="46" rx="12" class="il-chip" />
      <path d="M71 50 l6 6 l12 -13" class="il-check" data-fx="pop" data-step="1" />
    </g>
  )}
</svg>
