---
// Reveal-on-scroll plus the figure count-up. The illustrations are mock-ups, so
// they are deliberately animated: a number that counts and a bar that grows
// reads as a demo, where a static panel reads as a screenshot of real accounts.
---

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Animate the first number inside `el`, keeping its prefix, suffix and separators. */
  function countUp(el: HTMLElement) {
    // The unit ("/mo", "yrs") lives in a child span, so only walk text nodes.
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let node: Text | null = null;
    while ((node = walker.nextNode() as Text | null)) {
      if (/\d/.test(node.nodeValue || "")) break;
    }
    if (!node) return;

    const original = node.nodeValue!;
    const match = original.match(/-?[\d,]*\d(?:\.\d+)?/);
    if (!match) return;

    const raw = match[0];
    const target = Number(raw.replace(/,/g, ""));
    if (!Number.isFinite(target)) return;

    // A bare year ("2031") counting up from zero reads as a bug, not a demo.
    const bare = !/[$%]/.test(original) && !raw.includes(",");
    if (bare && target >= 1900 && target <= 2100) return;

    const decimals = (raw.split(".")[1] || "").length;
    const grouped = raw.includes(",");
    const before = original.slice(0, match.index!);
    const after = original.slice(match.index! + raw.length);
    const render = (n: number) => {
      const fixed = n.toFixed(decimals);
      const shown = grouped ? Number(fixed).toLocaleString("en-US", {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      }) : fixed;
      node!.nodeValue = before + shown + after;
    };

    const start = performance.now();
    const dur = 900;
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / dur);
      render(target * (1 - Math.pow(1 - t, 3)));   // easeOutCubic
      if (t < 1) requestAnimationFrame(tick);
      else node!.nodeValue = original;             // land exactly on the source text
    };
    render(0);
    requestAnimationFrame(tick);
  }

  const counted = new WeakSet<HTMLElement>();
  // .inst .tot is excluded on purpose: counting a total while its rows stay
  // static shows a sum that does not match the numbers beneath it.
  const FIGURES = ".nw-figure, .jr-count, .stat .figure, .figure-sm";

  function activate(el: HTMLElement) {
    el.classList.add("in-view");
    if (reduced) return;
    el.querySelectorAll<HTMLElement>(FIGURES).forEach((f) => {
      if (!counted.has(f)) { counted.add(f); countUp(f); }
    });
  }

  const targets = document.querySelectorAll<HTMLElement>(".rv");
  if (!("IntersectionObserver" in window)) {
    targets.forEach(activate);
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { activate(e.target as HTMLElement); io.unobserve(e.target); }
        }
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
