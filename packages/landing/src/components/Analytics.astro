---
// Umami, on the hosted deployment only. No id, no tag, no analytics request,
// which is what a self-hosted build gets.
//
// is:inline keeps Astro's hands off it: without it Astro treats the tag as a
// bundled module and rewrites it.
//
// The tracker is created here rather than written straight into the markup
// because a tag in the markup loads before anything can check for an opt-out.
// The tracker's own data-do-not-track only makes it read navigator.doNotTrack,
// and it knows nothing about Global Privacy Control, which is a binding opt-out
// in California. Under either signal this loads nothing and requests nothing.
//
// data-exclude-search and data-exclude-hash drop the query string and the
// fragment, so nothing carried in a link ever reaches umami. These pages have
// no ids in their paths, so unlike the app they need no before-send.
import { UMAMI_WEBSITE_ID } from "../config";
---

{
  UMAMI_WEBSITE_ID && (
    <script is:inline define:vars={{ websiteId: UMAMI_WEBSITE_ID }}>
      (function () {
        var dnt = navigator.doNotTrack || window.doNotTrack || navigator.msDoNotTrack;
        if (navigator.globalPrivacyControl === true || dnt === "1" || dnt === "yes") return;
        var script = document.createElement("script");
        script.defer = true;
        script.src = "https://cloud.umami.is/script.js";
        script.setAttribute("data-website-id", websiteId);
        script.setAttribute("data-do-not-track", "true");
        script.setAttribute("data-exclude-search", "true");
        script.setAttribute("data-exclude-hash", "true");
        document.head.appendChild(script);
      })();
    </script>
  )
}
