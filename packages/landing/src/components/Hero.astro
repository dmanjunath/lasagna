---
import { SIGNUP_URL, GITHUB_URL } from "../config";
import Icon from "./Icon.astro";

// One action on screen at a time. The demo completes it and brings up the next,
// which is what the product actually asks you to do.
import { ACTIONS as actions } from "../demo-data";

---

<a id="top"></a>
<section class="hero wrap">
  <div class="hero-copy rv">
    <h1 class="display">Don't know where to start with your finances?</h1>
    <p class="hero-sub">
      Not just a budgeting app, LasagnaFi guides you along your financial journey.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href={SIGNUP_URL}>Get started for free <Icon name="arrow" size={17} /></a>
      <a class="btn btn-ghost btn-lg" href={GITHUB_URL}><Icon name="github" size={17} /> See the source code</a>
    </div>
  </div>

  <div class="hero-art rv" style="animation-delay:.14s">
    <div class="card hero-actions" data-demo data-demo-ack="done" data-demo-labels="3 left|2 left|1 left">
      <div class="card-head">
        <div class="card-title">Actions</div>
        <span class="chip-meta" data-demo-label>{actions.length} left</span>
      </div>

      <div class="demo-stage" data-demo-stage>
        {actions.map((a, i) => (
          <article class:list={["demo-item", { "is-active": i === 0 }]} data-demo-frame>
            <div class={`row open bar ${a.cat}`}>
              <div class="row-main">
                <span class={`row-icon ${a.cat}`}><Icon name={a.icon} /></span>
                <div class="row-body">
                  <b>{a.title}</b>
                  <em>{a.sub}</em>
                  <span class="row-chips">
                    <span class={`chip-meta ${a.cat}`}>{a.f}</span>
                    <span class="chip-meta">{a.worth}</span>
                  </span>
                </div>
              </div>

              <div class="row-detail">
                <p>{a.detail}</p>
                <span class="detail-label">The account behind this</span>
                <div class="evidence">
                  <span class="ev-icon"><Icon name={a.icon} /></span>
                  <div><b>{a.evidence.name}</b><em>{a.evidence.meta}</em></div>
                  <span class:list={["ev-amt", { neg: a.evidence.neg }]}>{a.evidence.amt}</span>
                </div>
                <div class="rowbar">
                  <span class="btn btn-ghost btn-sm">{a.cta}</span>
                  <span class="btn btn-primary btn-sm" data-demo-target>Mark complete</span>
                </div>
              </div>

              <span class="demo-check" aria-hidden="true"><Icon name="check" /></span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

