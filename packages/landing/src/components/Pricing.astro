---
import { SIGNUP_URL, GITHUB_URL } from "../config";
import Icon from "./Icon.astro";

const tiers = [
  {
    name: "Open source",
    tag: "Run it yourself",
    amt: "$0",
    per: "self-hosted",
    sub: "Run the whole app on your own server.",
    items: [
      "The same code that runs the hosted app",
      "No subscription and no account with us",
      "You supply your own Plaid and AI keys",
      "Your accounts and transactions stay in your own database",
      "MIT licensed, runs on Docker",
    ],
    cta: { label: "See the source code", href: GITHUB_URL, icon: "github" as const, kind: "btn-secondary" },
  },
  {
    name: "Free",
    tag: "Hosted by us",
    amt: "$0",
    per: "a month",
    sub: "We run the app for you.",
    items: [
      "Up to 2 institutions, no account limit per institution",
      "Your accounts refresh once a day",
      "Full chat on the standard AI model",
      "Every planning tool, including tax",
      "The same privacy rules as Pro",
    ],
    cta: { label: "Create a free account", href: SIGNUP_URL, icon: "arrow" as const, kind: "btn-secondary" },
  },
  {
    name: "Pro",
    tag: "Hosted by us",
    amt: "$11.99",
    per: "a month",
    sub: "More institutions, and sync whenever you want.",
    items: [
      "Up to 50 institutions, no account limit per institution",
      "Sync now to refresh whenever you want",
      "The larger AI models, Sonnet and Opus",
      "Your requests run first",
      "Everything in Free",
    ],
    cta: { label: "Sign up for Pro", href: SIGNUP_URL, icon: "arrow" as const, kind: "btn-primary" },
    featured: true,
  },
];
---

<section class="section band" id="pricing">
  <div class="wrap">
    <div class="sec-head center" data-reveal>
      <h2>Pricing</h2>
      <p class="lead">LasagnaFi is open source, so you can run it on your own server for free. If you'd rather not run a server, use the hosted app. It's free to start, and Pro adds more institutions and the larger AI models.</p>
    </div>
    <div class="tiers">
      {tiers.map((t) => (
        <div class:list={["card tier", { featured: t.featured }]} data-reveal>
          <div class="tier-name">{t.name}</div>
          <div class="tier-tag">{t.tag}</div>
          <div class="price"><span class="amt">{t.amt}</span><span class="per">{t.per}</span></div>
          <p class="sub">{t.sub}</p>
          <ul>
            {t.items.map((i) => <li><Icon name="check" size={16} /><span>{i}</span></li>)}
          </ul>
          <a class:list={["btn", t.cta.kind]} href={t.cta.href}>
            {t.cta.icon === "github" && <Icon name="github" />}
            {t.cta.label}
            {t.cta.icon === "arrow" && <Icon name="arrow" />}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
