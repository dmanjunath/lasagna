---
import Base from "../layouts/Base.astro";
import Phone from "../components/Phone.astro";
import Icon from "../components/Icon.astro";
import FinalCta from "../components/FinalCta.astro";

const tools = [
  {
    id: "taxes",
    tint: "pasta",
    title: "Taxes",
    body: "Upload your tax return and brokerage forms. LasagnaFi reads them against your connected accounts.",
    points: [
      "Unused room in an HSA, 401(k) or IRA",
      "Over-withholding against last year's return",
      "Unrealized losses that can offset gains",
      "Estimated quarterly payments",
    ],
  },
  {
    id: "debt",
    tint: "sauce",
    title: "Debt payoff",
    body: "Every card, loan and mortgage in one payoff schedule, with the date you finish and the total interest it costs.",
    points: [
      "Avalanche: highest rate first, least interest",
      "Snowball: smallest balance first, accounts close sooner",
      "Add an extra monthly payment and the date moves",
    ],
  },
  {
    id: "retirement",
    tint: "denim",
    title: "Retirement",
    body: "Your plan runs through 1,000 simulated markets out to age 90, plus a backtest against market history since 1928.",
    points: [
      "Shows the chance your money lasts",
      "85% or better counts as on track",
      "Change your retirement age or savings and it runs again",
    ],
  },
  {
    id: "goals",
    tint: "basil",
    title: "Goals",
    body: "Name what you are saving for, set a target amount and, if you like, a date. Link the accounts that hold the money.",
    points: [
      "Progress follows the linked balances",
      "An optional planned monthly contribution",
    ],
  },
  {
    id: "chat",
    tint: "denim",
    title: "Chat",
    body: "Ask about your own money. Answers use your balances, rates and tax bracket, and show the calculation behind them.",
    points: [
      "Your name, banks and account numbers are swapped for codes first",
      "The free plan uses the standard model, Pro adds the larger ones",
    ],
  },
] as const;
---

<Base
  title="Features | LasagnaFi"
  description="What LasagnaFi does with the accounts you connect: actions, spending, transactions, your financial journey, net worth, taxes, debt payoff, retirement, goals and chat."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Features</h1>
      <p class="lead">
        LasagnaFi looks at all the accounts you connect and shows where you
        stand on spending, taxes, debt, retirement and savings, with options and
        estimates for you to weigh.
      </p>
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap">
      <div class="feature top" id="actions" data-reveal>
        <div class="f-copy">
          <h2>Actions</h2>
          <p>
            A list of what LasagnaFi found in your accounts, for now and over the
            next month, with an estimate of what each could save or earn. Open
            one to see the account and the numbers behind it.
          </p>
          <ul class="points">
            <li><span class="tick pasta"><Icon name="check" size={14} /></span> Covers spending, taxes, retirement, debt and savings</li>
            <li><span class="tick pasta"><Icon name="check" size={14} /></span> The list updates as your balances change</li>
          </ul>
        </div>
        <div class="f-art"><Phone src="/shots/actions.png" alt="The Actions screen: items for now and the next month, each labelled with an estimated value." tilt="right" eager /></div>
      </div>

      <div class="feature flip top" id="spending" data-reveal>
        <div class="f-copy">
          <h2>Spending</h2>
          <p>
            Transactions are categorized automatically. Each month shows money
            in, money out and your savings rate. When a category runs above its
            recent average, it's marked, and it can show up in Actions with a
            dollar estimate.
          </p>
          <ul class="points">
            <li><span class="tick sauce"><Icon name="check" size={14} /></span> Month and year views</li>
            <li><span class="tick sauce"><Icon name="check" size={14} /></span> Tap a category to see the transactions behind it</li>
            <li><span class="tick sauce"><Icon name="check" size={14} /></span> Transfers between your own accounts stay out of the totals</li>
          </ul>
        </div>
        <div class="f-art"><Phone src="/shots/spending.png" alt="The Spending screen for November: spent so far, income, net and savings rate, a chart of recent months and the breakdown by category." tilt="left" /></div>
      </div>

      <div class="feature top" id="transactions" data-reveal>
        <div class="f-copy">
          <h2>Transactions</h2>
          <p>
            Open a transaction to change its category, add a note or leave it out
            of your spending. Your change stays when the account syncs again.
          </p>
          <ul class="points">
            <li><span class="tick sauce"><Icon name="check" size={14} /></span> The bank's own description is kept beside the merchant</li>
            <li><span class="tick sauce"><Icon name="check" size={14} /></span> Card payments count as transfers, never as income</li>
          </ul>
        </div>
        <div class="f-art"><Phone src="/shots/transaction.png" alt="A transaction opened from the list: Costco, $74.29 on a credit card, with its category, the bank description, a note field and a switch to exclude it from spending." tilt="right" /></div>
      </div>

      <div class="feature flip top" id="journey" data-reveal>
        <div class="f-copy">
          <h2>Your financial journey</h2>
          <p>
            Your steps run from a starter emergency fund to retirement.
            LasagnaFi uses your account balances to show where you are, and you
            can work on the steps in any order.
          </p>
          <ul class="points">
            <li><span class="tick basil"><Icon name="check" size={14} /></span> Each step shows the dollar amount that finishes it</li>
          </ul>
        </div>
        <div class="f-art"><Phone src="/shots/journey.png" alt="The Financial journey screen: step 2 of 10, a credit card balance, with an on track estimate for retiring at 65." tilt="left" /></div>
      </div>

      <div class="feature top" id="net-worth" data-reveal>
        <div class="f-copy">
          <h2>Net worth</h2>
          <p>
            Cash, investments and property minus cards and loans. It updates as
            your accounts sync, and you can add anything Plaid can't connect by
            hand.
          </p>
          <ul class="points">
            <li><span class="tick denim"><Icon name="check" size={14} /></span> A home's value estimated from its address, or your own figure</li>
            <li><span class="tick denim"><Icon name="check" size={14} /></span> Group accounts by type or by institution</li>
          </ul>
        </div>
        <div class="f-art"><Phone src="/shots/accounts.png" alt="The Accounts screen: net worth of $98,468 with a chart over time, and cash accounts listed below." tilt="right" /></div>
      </div>
      <p class="disclaimer" data-reveal>LasagnaFi is not a registered investment advisor, broker, or financial planner, and nothing in the app is financial, investment, tax, or legal advice. Everything you see is for information and education only. <a href="/terms">Terms of service</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head center" data-reveal>
        <h2>Planning tools</h2>
        <p class="lead">These use the accounts you already connected, so you don't enter balances again.</p>
      </div>
      <div class="tools">
        {tools.map((t) => (
          <article class="card tool" id={t.id} data-reveal>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
            <ul class="points">
              {t.points.map((p) => (
                <li><span class={`tick ${t.tint}`}><Icon name="check" size={14} /></span> {p}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FinalCta />
</Base>
