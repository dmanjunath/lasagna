---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FinalCta from "../components/FinalCta.astro";
import { GITHUB_URL } from "../config";

const connection = [
  { what: "Read balances, holdings and transactions", why: "So your net worth and your actions stay current.", ok: true },
  { what: "Move money, pay a bill or open an account", why: "The connection has no write access.", ok: false },
  { what: "See your bank password", why: "You sign in to your bank, not to us.", ok: false },
];

const deletion = [
  { what: "Connected accounts", why: "Balances, holdings and transactions", verdict: "Deleted" },
  { what: "Chat history", why: "Every question and answer", verdict: "Deleted" },
  { what: "Document figures", why: "What was read from your tax forms", verdict: "Deleted" },
  { what: "Bank connections", why: "The link at Plaid", verdict: "Removed" },
];
---

<Base
  title="Data Privacy | LasagnaFi"
  description="What LasagnaFi stores, what it sends to the AI, and what happens when you delete your account. The code is open source."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Data privacy</h1>
      <p class="lead">
        What LasagnaFi stores and what it sends to the AI. The code is open
        source if you want to check.
      </p>
    </div>
  </header>

  <section class="section-tight">
    <div class="wrap">
      <div class="ai-use" id="ai" data-reveal>
        <h2>How LasagnaFi uses AI</h2>
        <p>
          Balances, totals, spending categories, debt payoff dates and the
          retirement simulation are worked out without AI. AI writes the items in
          Actions and their estimates, answers chat, orders and describes some
          journey steps, reads uploaded tax documents, writes the explanation in
          a retirement plan, fills in your profile from setup text, and sorts
          holdings the app doesn't recognize. It can get things wrong, so check
          a figure against your account before you rely on it.
        </p>
      </div>

      <div class="feature" id="redaction" data-reveal>
        <div class="f-copy">
          <h2>What the AI sees</h2>
          <p>
            Before anything goes to the AI, your name, banks and account numbers
            are replaced with codes. Balances, rates and dates are sent as they
            are, since the answers depend on them. The codes are swapped back
            before the answer shows up on your screen.
          </p>
          <ul class="points">
            <li><span class="tick denim"><Icon name="check" size={14} /></span> Names, banks and account numbers become codes</li>
            <li><span class="tick denim"><Icon name="check" size={14} /></span> Tax documents you upload are the exception, below</li>
            <li><span class="tick denim"><Icon name="check" size={14} /></span> What you type into setup goes as you wrote it</li>
          </ul>
        </div>
        <div class="f-art">
          <div class="card redact" aria-label="An example of what is sent to the AI">
            <p class="redact-title">What the AI receives</p>
            <dl>
              <div><dt>Your name</dt><dd><s>Alex Rivera</s> <code>Person A</code></dd></div>
              <div><dt>Account</dt><dd><s>First Bank Checking</s> <code>Account 1</code></dd></div>
              <div><dt>Account number</dt><dd><s>ending 0183</s> <code>removed</code></dd></div>
              <div><dt>Balance</dt><dd>$14,753</dd></div>
              <div><dt>Card rate</dt><dd>24.99%</dd></div>
            </dl>
            <p class="redact-note">Sample data. Each struck value is replaced by what follows it.</p>
          </div>
        </div>
      </div>

      <div class="feature flip" id="tax-documents" data-reveal>
        <div class="f-copy">
          <h2>Tax documents</h2>
          <p>
            When you upload a tax document, the AI reads the page exactly as it
            is printed, so it sees everything on it, including your name and
            your Social Security number. LasagnaFi keeps the figures it needs
            and deletes the file.
          </p>
        </div>
        <div class="f-art">
          <div class="card note-card">
            <span class="pi"><Icon name="eye" /></span>
            <p>Uploading a tax document is optional. If you would rather the AI never see a full page, skip it.</p>
          </div>
        </div>
      </div>

      <div class="feature" id="connections" data-reveal>
        <div class="f-copy">
          <h2>Account connections are read only</h2>
          <p>
            Your accounts connect through Plaid with read-only access to
            balances, holdings and transactions. LasagnaFi can't make a payment,
            a transfer or any change to an account through it.
          </p>
          <ul class="points">
            <li><span class="tick basil"><Icon name="check" size={14} /></span> Disconnect any institution from settings</li>
            <li><span class="tick basil"><Icon name="check" size={14} /></span> Disconnecting stops the sync right away</li>
          </ul>
        </div>
        <div class="f-art">
          <div class="card facts-table">
            <h3 class="facts-title">What the connection allows</h3>
            {connection.map((r) => (
              <div class="row">
                <div><b>{r.what}</b><span>{r.why}</span></div>
                <span class:list={["verdict", r.ok ? "yes" : "no"]}>{r.ok ? "Yes" : "No"}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="feature flip" id="open-source" data-reveal>
        <div class="f-copy">
          <h2>The code is open source</h2>
          <p>
            Chat, actions and the planning tools all send data to the AI through
            one file, the one that swaps in the codes. A test fails if any other
            file calls the AI directly, apart from the two that read setup text
            and tax documents.
          </p>
          <ul class="points">
            <li><span class="tick pasta"><Icon name="check" size={14} /></span> MIT licensed, on GitHub</li>
            <li><span class="tick pasta"><Icon name="check" size={14} /></span> Run the whole app on your own server if you prefer</li>
          </ul>
          <p style="margin-top:24px"><a class="btn btn-secondary" href={GITHUB_URL}><Icon name="github" /> See the source code</a></p>
        </div>
        <div class="f-art">
          <div class="card code-card">
            <p class="code-file">llm-boundary.test.ts</p>
            <pre><code>it("never imports the model directly", () =&gt; {'{'}
  const direct = sourceFiles()
    .filter((f) =&gt; f.imports("ai"))
    .filter((f) =&gt; f !== "lib/llm.ts");

  expect(direct).toEqual([]);
{'}'});</code></pre>
            <p class="redact-note">A simplified version of the test in the repository.</p>
          </div>
        </div>
      </div>

      <div class="feature" id="deletion" data-reveal>
        <div class="f-copy">
          <h2>Deleting your account</h2>
          <p>
            You can delete your account from Settings without contacting us. It
            removes your connected accounts, balances, chat history and the
            figures read from your documents, and disconnects your banks at
            Plaid.
          </p>
          <ul class="points">
            <li><span class="tick sauce"><Icon name="check" size={14} /></span> Your data is not sold or shared with advertisers</li>
          </ul>
        </div>
        <div class="f-art">
          <div class="card facts-table">
            <h3 class="facts-title">What deletion removes</h3>
            {deletion.map((r) => (
              <div class="row">
                <div><b>{r.what}</b><span>{r.why}</span></div>
                <span class="verdict no">{r.verdict}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <FinalCta />
</Base>
