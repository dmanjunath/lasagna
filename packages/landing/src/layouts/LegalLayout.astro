---
import Base from "./Base.astro";

// The legal pages keep their text exactly as published. Only the frame changed.
export interface Props {
  title: string;
  lastUpdated: string;
}
const { title, lastUpdated } = Astro.props;
---

<Base title={`${title} | LasagnaFi`} description={`${title} for LasagnaFi.`}>
  <div class="legal">
    <header class="legal-header">
      <h1>{title}</h1>
      <p class="last-updated">Last updated: {lastUpdated}</p>
    </header>
    <article class="legal-body">
      <slot />
    </article>
  </div>
</Base>
