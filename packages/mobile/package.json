    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "ios:archive": "bash scripts/ios-archive.sh",
    "ota:publish": "bash scripts/ota-publish.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@web/(.*)$": "<rootDir>/../web/src/$1",
      "^@lasagna/design$": "<rootDir>/../design/src/index.ts",
      "^@lasagna/design/build/toCss$": "<rootDir>/../design/src/build/toCss.ts",
      "^@lasagna/design/build/webCss$": "<rootDir>/../design/src/build/webCss.ts",
      "^@lasagna/core/goal-target$": "<rootDir>/../core/src/goal-target.ts",
      "^@lasagna/core/debt-payoff$": "<rootDir>/../core/src/debt-payoff.ts"
    }
  }
}
