# Database
DATABASE_URL=postgresql://lasagna:lasagna@localhost:5432/lasagna

# Encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public HTTPS URL Plaid POSTs item updates to, e.g.
# https://api.example.com/api/plaid/webhook. Leave blank locally — Plaid can't
# reach localhost, so no webhook is registered and the cron is the only sync
# trigger.
PLAID_WEBHOOK_URL=

# Tenancy mode. Decides whether signing up makes you an operator.
#   false -> single tenant. EVERY account created is an internal admin with full
#            admin-console access. Correct for a personal self-hosted install
#            where you are the only user. NEVER set this on a deployment other
#            people can sign up to.
#   anything else (true, unset, empty, a typo) -> multi tenant. Signing up never
#            grants admin. Operators are promoted one at a time in the console.
# Only the exact string "false" opts in, so a missing or mistyped value can
# never hand the console to a stranger.
MULTI_TENANT=false

# Hosted mode. When true, generated portfolio actions state general allocation
# guidance rather than the reader's own holdings and figures. Leave false for a
# self-hosted deployment, which keeps the personalized wording.
HOSTED_MODE=false

# Server
PORT=3000

# OpenRouter (for AI agent)
OPENROUTER_API_KEY=

# Record/replay for model calls, so local work costs nothing and is repeatable.
#   off     real provider call. The ONLY value production may run - anything
#           else throws there, because replaying a recorded answer for a real
#           household would hand them another household's advice.
#   record  real provider call, saved to packages/api/fixtures/llm, and the
#           price of the call printed. Seeded/synthetic tenants only.
#   replay  served from the stored fixture, never the network. A miss throws and
#           names the command to record it.
# Blank means "off". docker-compose.yml sets "replay" for local development, so
# you only need this to override that from the shell.
LLM_FIXTURES=

# sailresearch.com inference (OpenAI-compatible alternative to OpenRouter).
# Set SAIL_RESEARCH_API_KEY to route inference through sail instead of OpenRouter.
# INFERENCE_PROVIDER (openrouter|sail) overrides selection; if unset, sail is used
# automatically when SAIL_RESEARCH_API_KEY is present.
SAIL_RESEARCH_API_KEY=
INFERENCE_PROVIDER=

# Tax document extraction. Defaults to Vertex AI, which needs no config: auth
# and project both come from ADC. Set VISION_PROVIDER=openai-compatible to send
# documents to another endpoint instead, which needs the three below.
VISION_PROVIDER=
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# Environment label sent to OpenRouter as X-OpenRouter-Title ("LasagnaFi <APP_ENV>"). Defaults to NODE_ENV or "dev".
APP_ENV=dev

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
APP_URL=http://localhost:5173

# WorkOS (optional). When BOTH are set, auth uses WorkOS (email/password + Sign in with Google,
# email verification, password reset). When either is blank, the app falls back to local
# email/password only (no Google) — fine for self-hosting without a WorkOS account.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Optional; defaults to ${APP_URL}/api/auth/google/callback. Must be registered as an allowed
# redirect URI on the WorkOS AuthKit application.
WORKOS_REDIRECT_URI=

# Google Maps — server-side key for the Places address-autocomplete proxy
# (/api/places/*). Kept off the client. Needs the "Places API (New)" enabled
# on the Google Cloud project.
GOOGLE_MAPS_API_KEY=

# Real-estate value estimates
# URL is the datasets base (ends with /datasets/v3),
# KEY is the Bearer token, DATASET_ID selects the property dataset.
REAL_ESTATE_VALUES_API_URL=
REAL_ESTATE_VALUES_API_KEY=
REAL_ESTATE_VALUES_DATASET_ID=

# Umami analytics (optional, front end only). VITE_ is the app (packages/web,
# Vite) and PUBLIC_ is the marketing site (packages/landing, Astro) because the
# two surfaces use different bundlers. Set each to that surface's umami website
# id. Leave blank to turn analytics off, which is what a self-hosted deployment
# wants: no script tag is rendered and nothing is requested from umami.
# The hosted deployment sets these as Cloudflare Pages build-time variables, so
# they are baked into the bundle at build time rather than read from this file.
VITE_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_WEBSITE_ID=
